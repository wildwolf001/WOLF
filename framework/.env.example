# WOLF 2.0 Backend Environment Configuration
# Copy this file to .env and fill in the values

# Server Configuration
HOST=0.0.0.0
PORT=8080
DEBUG=false

# LLM Provider Configuration
LLM_PROVIDER=minimax
MINIMAX_API_KEY=your-minimax-api-key
# MiniMax Group ID (optional - leave empty if your account doesn't require it)
MINIMAX_GROUP_ID=
MINIMAX_MODEL=MiniMax-M2.7
# MiniMax API Base URL
# Domestic China: https://api.minimaxi.com (default)
# International: https://api.minimax.io
MINIMAX_BASE_URL=https://api.minimaxi.com

# Database
DATABASE_URL=sqlite:///./wolf.db

# Authentication
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Session
SESSION_SECRET=your-session-secret
SESSION_TIMEOUT=86400

# Workspace
DEFAULT_WORKSPACE=/workspace/default
MAX_WORKSPACES=10

# MCP Servers
MCP_SERVERS_PATH=./mcp_servers.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=wolf.log

# External Services
ANTHROPIC_API_KEY=your-api-key
OPENAI_API_KEY=your-api-key

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60